# Paste your real Groq API key below (get one free at https://console.groq.com/keys)
# This file is already git-ignored — never commit your real key.
GROQ_API_KEY="My_Api_KEY"

# Your PHP API base URL (see php_api_additions/ and the README section
# "Connecting your real database"). Leave blank to run in demo mode
# with no server. Common values:
#   Android emulator -> host machine:  http://10.0.2.2/digital-art-school/api
#   iOS simulator:                     http://127.0.0.1/digital-art-school/api
#   Physical device on same Wi-Fi:     http://<your-LAN-IP>/digital-art-school/api
API_BASE_URL=http://192.168.137.1/digital-art-school/api
